/*Paint the completed matrix on the canvas*/
const canvas = document.querySelector("canvas");
ctx = canvas.getContext("2d");
ctx.font = "24px Arial";
const start = 30;
let x = start;
let y = start;

for(j=0;j<grid.length;j++){
    for(i=0;i<grid[j].length;i++){
        ctx.fillText(grid[j][i].letter,x,y);
        x = x + 30;
    }
    x = start;
    y = y + 30;
}





